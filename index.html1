<!DOCTYPE html>
<html>
<head>
    <title>Student Bio Data</title>
</head>
<body>

<center>
    <!-- Top section: Photo + Name -->
    <table border="0" cellpadding="10">
        <tr>
            <!-- Photo -->
            <td style="border:2px solid black; width:120px; height:120px; text-align:center;">
                <img src="myphoto.jpeg" alt="Shristi Khanal" style="width:120px; height:120px; object-fit:cover;">
            </td>
            <!-- Name -->
            <td>
                <b>Name:</b><br>
                <input type="text" value="SHRISTI KHANAL" style="text-align:center; width:200px; font-weight:bold;">
            </td>
        </tr>
    </table>

    <br>

    <!-- Details Section -->
    <b>Details</b><br><br>
    <table border="0" cellpadding="5">
        <tr>
            <td style="width:80px;">Name:</td>
            <td><input type="text" value="Shristi Khanal" style="width:200px;"></td>
        </tr>
        <tr>
            <td>Class:</td>
            <td><input type="text" value="11" style="width:200px;"></td>
        </tr>
        <tr>
            <td>Father:</td>
            <td><input type="text" value="Madhu Khanal" style="width:200px;"></td>
        </tr>
        <tr>
            <td>Mother:</td>
            <td><input type="text" value="Shova Khanal" style="width:200px;"></td>
        </tr>
        <tr>
            <td>Brother:</td>
            <td><input type="text" value="Samir Khanal" style="width:200px;"></td>
        </tr>
        <tr>
            <td>Address:</td>
            <td><input type="text" value="Rampur 6 Palpa, Talpokhara" style="width:200px;"></td>
        </tr>
        <tr>
            <td>Contact:</td>
            <td><input type="text" value="9743466123" style="width:200px;"></td>
        </tr>
    </table>

    <br>

    <!-- Hobby -->
    <b>Hobby</b>
    <ol>
        <li>Cooking</li>
        <li>Singing</li>
        <li>Reading Novel</li>
        <li>Writing</li>
    </ol>

    <br>

    <!-- Education -->
    <b>Education</b><br>
    <table border="2" cellpadding="5" cellspacing="0" width="80%">
        <tr>
            <th>S.N</th>
            <th>Level</th>
            <th>Degree</th>
            <th>GPA</th>
            <th>Remark</th>
        </tr>
        <tr>
            <td>1</td>
            <td>8</td>
            <td>-</td>
            <td>3.78</td>
            <td>Pass</td>
        </tr>
        <tr>
            <td>2</td>
            <td>SEE</td>
            <td>-</td>
            <td>3.67</td>
            <td>Pass</td>
        </tr>
    </table><br>

    <!-- Language -->
    <b>Language</b><br>
    Nepali <input type="range" min="1" max="10"><br>
    Hindi <input type="range" min="1" max="10"><br>
    English <input type="range" min="1" max="10"><br><br>

    <!-- Submit -->
    <input type="submit" value="Submit">

</center>

</body>
          </html>
